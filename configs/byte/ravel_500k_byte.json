{
  "name": "ravel_500k_byte",
  "tokenizer": "byte",
  "notes": "~500k trainable params, byte-level TinyStories baseline.",
  "vocab_size": 260,
  "block_size": 256,
  "d_model": 80,
  "n_layers": 6,
  "mlp_mult": 2.0,
  "dropout": 0.0,
  "tie_weights": true,
  "conv_kernel": 5,
  "address_space": 512,
  "n_literal_heads": 2,

  "payload_dim": 16,
  "last_k": 1,
  "memory_every": 1,
  "use_sum_read": false,
  "learning_rate": 0.0005,
  "weight_decay": 0.1,
  "batch_size": 24,
  "max_steps": 15000,
  "warmup_steps": 300,
  "eval_interval": 500,
  "eval_batches": 20
}

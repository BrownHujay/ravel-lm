{
  "name": "ravel_5m_bpe2k",
  "tokenizer": "bpe",
  "notes": "BPE config for a 2048-token byte-BPE tokenizer; still near 5M because embeddings are tied.",
  "vocab_size": 2048,
  "block_size": 768,
  "d_model": 192,
  "n_layers": 11,
  "mlp_mult": 2.2,
  "dropout": 0.0,
  "tie_weights": true,
  "conv_kernel": 7,
  "address_space": 4096,
  "n_literal_heads": 2,
  "n_learned_heads": 1,
  "n_codebooks": 2,
  "codebook_size": 16,
  "payload_dim": 32,
  "last_k": 1,
  "memory_every": 1,
  "use_sum_read": false,
  "learning_rate": 0.0003,
  "weight_decay": 0.1,
  "batch_size": 4,
  "max_steps": 50000,
  "warmup_steps": 1000,
  "eval_interval": 1000,
  "eval_batches": 20
}

{
  "name": "ravel_300k_bpe1k",
  "tokenizer": "bpe",
  "notes": "BPE config for a 1024-token byte-BPE tokenizer; train one with scripts/train_bpe.py.",
  "vocab_size": 1024,
  "block_size": 256,
  "d_model": 68,
  "n_layers": 3,
  "mlp_mult": 2.0,
  "dropout": 0.0,
  "tie_weights": true,
  "conv_kernel": 5,
  "address_space": 2048,
  "n_literal_heads": 2,
  "n_learned_heads": 1,
  "n_codebooks": 2,
  "codebook_size": 16,
  "payload_dim": 16,
  "last_k": 1,
  "memory_every": 1,
  "use_sum_read": false,
  "learning_rate": 0.0006,
  "weight_decay": 0.1,
  "batch_size": 32,
  "max_steps": 10000,
  "warmup_steps": 200,
  "eval_interval": 500,
  "eval_batches": 20
}
